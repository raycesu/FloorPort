NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only: shared price_cache table (RLS blocks anon; service role bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: restrict /api/debug/cache-stats to this user email (otherwise any signed-in user)
FLOORPORT_ADMIN_EMAIL=
# Optional: parallel CoinGecko history fetches per cold chart load (default 2)
COINGECKO_HISTORY_CONCURRENCY=4
# Skip market_chart for holdings below this USD value (uses spot in chart; default 50)
CHART_HISTORY_MIN_USD=25
# Per-coin CoinGecko history timeout in ms (default 12000)
COINGECKO_HISTORY_COIN_TIMEOUT_MS=12000
